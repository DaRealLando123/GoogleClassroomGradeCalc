{
  "manifest_version": 3,
  "name": "Google Classroom Grade Calculator | GCGC",
  "version": "1.3",
  "description": "Change assignment scores to see how they affect your overall grade.",
  "permissions": ["webRequest"],
  "host_permissions": ["*://*.classroom.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Classroom Grade Calculator | GCGC",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.classroom.google.com/*"
      ],
      "css": ["styles.css"],
      "js": ["network-monitor.js", "grade-loader.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
        "resources": ["icon128.png"],
        "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
