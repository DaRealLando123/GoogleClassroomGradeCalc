{
  "manifest_version": 3,
  "name": "Google Classroom Grade Calculator",
  "version": "1.1",
  "description": "Change assignment scores to see how they affect your overall grade.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.classroom.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
        "resources": ["icon128.png"],
        "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
